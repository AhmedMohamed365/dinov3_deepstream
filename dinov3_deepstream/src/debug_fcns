static const char* nvds_meta_type_to_str(NvDsMetaType t) {
  switch (t) {
    case NVDS_PREPROCESS_BATCH_META: return "NVDS_PREPROCESS_BATCH_META";
    case NVDSINFER_TENSOR_OUTPUT_META: return "NVDSINFER_TENSOR_OUTPUT_META";
    default: return "OTHER";
  }
}

static void dump_caps(GstPad* pad) {
  GstCaps* caps = gst_pad_get_current_caps(pad);
  if (!caps) caps = gst_pad_query_caps(pad, nullptr);
  if (caps) {
    gchar* s = gst_caps_to_string(caps);
    std::cout << "[DEPTH DBG] caps: " << (s ? s : "(null)") << "\n";
    if (s) g_free(s);
    gst_caps_unref(caps);
  }
}

static void print_batch_user_meta(NvDsBatchMeta* batch_meta, uint64_t frame_num) {
  int i = 0;
  for (NvDsMetaList* l = batch_meta->batch_user_meta_list; l; l = l->next, ++i) {
    NvDsUserMeta* um = (NvDsUserMeta*)l->data;
    if (!um) continue;

    std::cout << "[DEPTH DBG] frame=" << frame_num
              << " batch_user_meta[" << i << "] type=" << um->base_meta.meta_type
              << " (" << nvds_meta_type_to_str((NvDsMetaType)um->base_meta.meta_type) << ")\n";

    if (um->base_meta.meta_type == NVDS_PREPROCESS_BATCH_META) {
      auto* pbm = (GstNvDsPreProcessBatchMeta*)um->user_meta_data;
      if (!pbm) { std::cout << "  pbm=null\n"; continue; }

      std::cout << "  target_unique_ids: ";
      for (auto id : pbm->target_unique_ids) std::cout << id << " ";
      std::cout << "\n";

      std::cout << "  roi_vector.size=" << pbm->roi_vector.size() << "\n";
      if (!pbm->roi_vector.empty()) {
        auto& r = pbm->roi_vector[0];
        std::cout << "  roi[0] xywh=(" << r.roi.left << "," << r.roi.top
                  << "," << r.roi.width << "," << r.roi.height << ")\n";
      }

      if (pbm->tensor_meta) {
        auto* tm = pbm->tensor_meta;
        std::cout << "  tensor_meta: name='" << tm->tensor_name
                  << "' bytes=" << tm->buffer_size
                  << " gpu_id=" << tm->gpu_id
                  << " dtype=" << tm->data_type
                  << " shape=[";
        for (size_t k = 0; k < tm->tensor_shape.size(); ++k) {
          std::cout << tm->tensor_shape[k] << (k + 1 < tm->tensor_shape.size() ? "," : "");
        }
        std::cout << "] raw_ptr=" << tm->raw_tensor_buffer << "\n";
      } else {
        std::cout << "  tensor_meta=null\n";
      }
    }
  }
}

static void print_all_tensor_metas_on_frame(NvDsFrameMeta* fmeta) {
  int i = 0;
  for (NvDsMetaList* l = fmeta->frame_user_meta_list; l; l = l->next, ++i) {
    NvDsUserMeta* um = (NvDsUserMeta*)l->data;
    if (!um) continue;
    if (um->base_meta.meta_type != NVDSINFER_TENSOR_OUTPUT_META) continue;

    auto* tmeta = (NvDsInferTensorMeta*)um->user_meta_data;
    if (!tmeta) continue;

    std::cout << "[DEPTH DBG] frame=" << fmeta->frame_num
              << " frame_user_meta[" << i << "] NVDSINFER_TENSOR_OUTPUT_META"
              << " uid=" << tmeta->unique_id
              << " num_outputs=" << tmeta->num_output_layers
              << " has_host=" << (tmeta->out_buf_ptrs_host != nullptr)
              << " has_dev=" << (tmeta->out_buf_ptrs_dev != nullptr)
              << "\n";

    for (unsigned j = 0; j < tmeta->num_output_layers; ++j) {
      auto& L = tmeta->output_layers_info[j];
      std::cout << "    - out[" << j << "] name=" << (L.layerName ? L.layerName : "(null)") << " dims=";
      for (int d = 0; d < L.inferDims.numDims; ++d) {
        std::cout << L.inferDims.d[d] << (d + 1 < L.inferDims.numDims ? "x" : "");
      }
      std::cout << " dtype=" << (int)L.dataType << "\n";
    }
  }
}

// Optional: dump frame meta errors/warnings if present
static void print_frame_user_meta_non_tensor(NvDsFrameMeta* fmeta) {
  int i = 0;
  for (NvDsMetaList* l = fmeta->frame_user_meta_list; l; l = l->next, ++i) {
    NvDsUserMeta* um = (NvDsUserMeta*)l->data;
    if (!um) continue;

    if (um->base_meta.meta_type == NVDSINFER_TENSOR_OUTPUT_META) continue;

    // If you want: print all meta types seen (helps spot unexpected things)
    // std::cout << "[DEPTH DBG] frame=" << fmeta->frame_num
    //           << " frame_user_meta[" << i << "] type=" << um->base_meta.meta_type << "\n";
  }
}

static inline const char* yesno(bool v){ return v ? "yes" : "no"; }

static GstPadProbeReturn
depth_src_pad_probe_debug(GstPad* pad, GstPadProbeInfo* info, gpointer user_data) {
  (void)pad; (void)user_data;

  constexpr guint DEPTH_UID = 2;
  const std::string DEPTH_LAYER = "depth";

  static uint64_t call_id = 0;
  call_id++;

  constexpr uint64_t VERBOSE_FIRST = 10;
  constexpr uint64_t PRINT_EVERY   = 30;

  const bool do_print = (call_id <= VERBOSE_FIRST) || ((call_id % PRINT_EVERY) == 0);

  GstBuffer* buf = GST_PAD_PROBE_INFO_BUFFER(info);
  if (!buf) return GST_PAD_PROBE_OK;

  if (do_print) {
    std::cout << "\n========== [DEPTH DBG2] probe call #" << call_id << " ==========\n";
    std::cout << "[DEPTH DBG2] buf=" << (void*)buf
              << " writable=" << yesno(gst_buffer_is_writable(buf))
              << "\n";
  }

  // If you want to WRITE pixels downstream, you MUST make it writable here.
  // This may create a new buffer; keep it if returned.
  buf = gst_buffer_make_writable(buf);
  if (!buf) return GST_PAD_PROBE_OK;
  GST_PAD_PROBE_INFO_DATA(info) = buf;

  NvDsBatchMeta* batch_meta = gst_buffer_get_nvds_batch_meta(buf);
  if (!batch_meta) {
    if (do_print) std::cerr << "[DEPTH DBG2] no batch_meta\n";
    return GST_PAD_PROBE_OK;
  }

  // Map GstBuffer -> NvBufSurface
  GstMapInfo in_map{};
  if (!gst_buffer_map(buf, &in_map, GST_MAP_READWRITE)) {
    if (do_print) std::cerr << "[DEPTH DBG2] gst_buffer_map(READWRITE) failed\n";
    return GST_PAD_PROBE_OK;
  }

  NvBufSurface* surface = (NvBufSurface*)in_map.data;
  if (!surface) {
    if (do_print) std::cerr << "[DEPTH DBG2] surface=null\n";
    gst_buffer_unmap(buf, &in_map);
    return GST_PAD_PROBE_OK;
  }

  if (do_print) {
    // Caps are often super helpful to ensure you’re probing where you think you are
    GstCaps* caps = gst_pad_get_current_caps(pad);
    if (caps) {
      gchar* s = gst_caps_to_string(caps);
      std::cout << "[DEPTH DBG2] caps: " << (s ? s : "(null)") << "\n";
      if (s) g_free(s);
      gst_caps_unref(caps);
    }

    std::cout << "[DEPTH DBG2] surface=" << (void*)surface
              << " numFilled=" << surface->numFilled
              << " memType=" << surface->memType
              << " batchSize=" << surface->batchSize
              << "\n";

    for (uint32_t i = 0; i < surface->numFilled; ++i) {
      auto& sl = surface->surfaceList[i];
      std::cout << "  surf[" << i << "] WxH=" << sl.width << "x" << sl.height
                << " pitch=" << sl.pitch
                << " colorFormat=" << sl.colorFormat
                << " dataPtr=" << (void*)sl.dataPtr
                << "\n";
    }

    // Print the batch-level preprocess meta (this is what nvinfer must consume)
    // Use your helper if you have it:
    // print_batch_user_meta(batch_meta, /*frame_num_unknown*/ 0);
  }

  bool saw_uid2 = false;
  bool saw_uid2_depth_layer = false;

  for (NvDsMetaList* l_frame = batch_meta->frame_meta_list; l_frame; l_frame = l_frame->next) {
    NvDsFrameMeta* fmeta = (NvDsFrameMeta*)l_frame->data;
    if (!fmeta) continue;

    if (do_print) {
      std::cout << "[DEPTH DBG2] frame_num=" << fmeta->frame_num
                << " batch_id=" << fmeta->batch_id
                << " pipeWxH=" << fmeta->pipeline_width << "x" << fmeta->pipeline_height
                << "\n";

      // Very important: show EVERYTHING on the frame
      print_batch_user_meta(batch_meta, fmeta->frame_num);
      print_all_tensor_metas_on_frame(fmeta);
    }

    // ---- A) Do we have UID=2 tensor output meta yet? ----
    NvDsInferTensorMeta* tmeta = find_tensor_meta_by_uid(fmeta, DEPTH_UID);
    if (!tmeta) {
      if (do_print) {
        std::cerr << "[DEPTH DBG2] NO NVDSINFER_TENSOR_OUTPUT_META uid=2 on frame "
                  << fmeta->frame_num
                  << " (depth nvinfer did not attach output)\n";
      }
    } else {
      saw_uid2 = true;

      if (do_print) {
        std::cout << "[DEPTH DBG2] FOUND uid=2 tensor meta. num_outputs="
                  << tmeta->num_output_layers << "\n";
        for (unsigned i = 0; i < tmeta->num_output_layers; ++i) {
          auto& L = tmeta->output_layers_info[i];
          std::cout << "  - out[" << i << "] name="
                    << (L.layerName ? L.layerName : "(null)")
                    << " numDims=" << L.inferDims.numDims
                    << "\n";
        }
      }

      int li = find_layer_index(tmeta, DEPTH_LAYER);
      if (li < 0) {
        if (do_print) {
          std::cerr << "[DEPTH DBG2] uid=2 present BUT layer '" << DEPTH_LAYER
                    << "' not found. (Your output layer name may differ)\n";
        }
      } else {
        saw_uid2_depth_layer = true;
        if (do_print) {
          std::cout << "[DEPTH DBG2] uid=2 has layer '" << DEPTH_LAYER
                    << "' at index " << li << "\n";
        }
      }
    }

    // ---- B) OPTIONAL sanity check: can we actually overwrite pixels? ----
    // Paint a simple pattern every PRINT_EVERY calls if uid=2 is missing,
    // so you can verify the probe location + writability path.
    if (!saw_uid2 && ((call_id % PRINT_EVERY) == 0)) {
      int b = (int)fmeta->batch_id;

      if (NvBufSurfaceMap(surface, b, -1, NVBUF_MAP_READ_WRITE) == 0) {
        NvBufSurfaceSyncForCpu(surface, b, -1);

        auto& sl = surface->surfaceList[b];
        if (sl.colorFormat == NVBUF_COLOR_FORMAT_NV12 ||
            sl.colorFormat == NVBUF_COLOR_FORMAT_NV12_ER) {

          uint8_t* y  = (uint8_t*)sl.mappedAddr.addr[0];
          uint8_t* uv = (uint8_t*)sl.mappedAddr.addr[1];

          const int outH = (int)sl.height;
          const int outW = (int)sl.width;
          const int pitch = (int)sl.pitch;

          // Gradient in Y so it is very obvious on screen
          for (int oy = 0; oy < outH; ++oy) {
            uint8_t* row = y + oy * pitch;
            for (int ox = 0; ox < outW; ++ox) {
              row[ox] = (uint8_t)((ox + (int)(fmeta->frame_num % 255)) & 0xFF);
            }
          }
          // Neutral UV
          for (int oy = 0; oy < outH / 2; ++oy) {
            std::memset(uv + oy * pitch, 128, outW);
          }

          NvBufSurfaceSyncForDevice(surface, b, -1);

          if (do_print) {
            std::cout << "[DEPTH DBG2] Painted TEST PATTERN on frame "
                      << fmeta->frame_num << " (because uid=2 missing)\n";
          }
        }

        NvBufSurfaceUnMap(surface, b, -1);
      } else if (do_print) {
        std::cerr << "[DEPTH DBG2] NvBufSurfaceMap failed (cannot paint test pattern)\n";
      }
    }
  }

  if (do_print) {
    std::cout << "[DEPTH DBG2] summary: saw_uid2=" << (saw_uid2 ? 1 : 0)
              << " saw_uid2_depth_layer=" << (saw_uid2_depth_layer ? 1 : 0)
              << "\n";
  }

  gst_buffer_unmap(buf, &in_map);
  return GST_PAD_PROBE_OK;
}